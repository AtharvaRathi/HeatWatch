# ============================================
# Environment Variables - Heatwave Prediction
# ============================================

# MongoDB Connection
MONGO_URI=mongodb://localhost:27017/heatwave_db

# Microservice Ports
WEATHER_SERVICE_PORT=5001
ALERT_SERVICE_PORT=5002
ADVISORY_SERVICE_PORT=5003
ANALYTICS_SERVICE_PORT=5004

# Monolithic Server Port
MONOLITHIC_PORT=5000

# Frontend API Base URL (Nginx Gateway)
VITE_API_BASE_URL=http://localhost:8080

# Nginx Gateway Port
NGINX_PORT=8080
