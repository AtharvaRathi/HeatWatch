# OpenWeatherMap
OPENWEATHERMAP_API_KEY=your_key_here

# Database
DATABASE_URL=postgresql+asyncpg://postgres:password@db:5432/heatwatch

# Redis
REDIS_URL=redis://redis:6379/0

# JWT
JWT_SECRET_KEY=your_super_secret_key_32chars_minimum
JWT_ALGORITHM=HS256
JWT_ACCESS_EXPIRE_MINUTES=30
JWT_REFRESH_EXPIRE_DAYS=7

# Mailjet Config
MAILJET_API_KEY=your_mailjet_api_key_here
MAILJET_API_SECRET=your_mailjet_secret_here
ALERT_FROM_EMAIL=alerts@heatwatch.com

# Web Push VAPID Keys
VAPID_PUBLIC_KEY=your_vapid_public_key
VAPID_PRIVATE_KEY=your_vapid_private_key
VAPID_EMAIL=mailto:admin@heatwatch.app

# App
ENVIRONMENT=development
FRONTEND_URL=http://localhost:5173
ALERT_POLL_INTERVAL_SECONDS=600
