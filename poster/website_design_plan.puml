@startuml
skinparam shadowing false
skinparam defaultTextAlignment center
skinparam defaultFontColor #333333
skinparam BackgroundColor white
skinparam rectangle {
    BorderColor #333333
    BorderThickness 1.5
    RoundCorner 10
    FontName Roboto
    FontColor #333333
}
skinparam arrowColor #666666
skinparam arrowThickness 1.5
skinparam arrowFontColor #333333

title [ Flow of Number of Pages Linked ]\nWebsite Design Plan: ThermaGuard

rectangle "1. Landing Page (Home)\n<size:12>Introduction & Features</size>" as P1 #e3f2fd
rectangle "2. User Authentication\n<size:12>Login / Register</size>" as P2 #f3e5f5
rectangle "3. Main Dashboard\n<size:12>Live Heatmap & Current Status</size>" as P3 #fff3e0
rectangle "4. Location Search\n<size:12>City-level Temperature Data</size>" as P4 #ffebee
rectangle "5. Alert Settings\n<size:12>SMS / Email Subscriptions</size>" as P5 #e0f2f1
rectangle "6. Safety Resources\n<size:12>Precautions & First Aid Guides</size>" as P6 #e8f5e9
rectangle "7. User Profile\n<size:12>Manage Account & History</size>" as P7 #eceff1

P1 -down-> P2 : " Navigate to Login"
P2 -down-> P3 : " Successful Authentication"
P3 -down-> P4 : " Search specific region"
P4 -down-> P5 : " Setup region alerts"
P5 -down-> P6 : " View survival guides"
P6 -down-> P7 : " Save to profile"

@enduml
